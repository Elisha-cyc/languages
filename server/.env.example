# Optional configuration
PORT=3000
TUTOR_MODEL=
NATIVE_LANGUAGE=English
WHISPER_MODEL=whisper-large-v3-turbo
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
INVITE_CODE=
ADMIN_PASSWORD=
RESEND_API_KEY=
NOTIFY_EMAIL=
CONTACT_EMAIL=
